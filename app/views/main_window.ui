      <!-- PESTAÑA 2: CARGA Y CONFIGURACIÓN -->
      <widget class="QWidget" name="tabUpload">
       <attribute name="title">
        <string>📂 Cargar Muestra</string>
       </attribute>
       <layout class="QVBoxLayout" name="vLayoutUpload">
        <item>
         <widget class="QGroupBox" name="groupConfig">
          <property name="title">
           <string>Selección de Tipo de Archivo y Motor C/Python</string>
          </property>
          <layout class="QFormLayout" name="formLayoutConfig">
           <item row="0" column="0">
            <widget class="QLabel" name="lblFileType">
             <property name="text"><string>Tipo de Archivo Preestablecido:</string></property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QComboBox" name="comboFileType">
             <item><property name="text"><string>PDF Document (.pdf)</string></property></item>
             <item><property name="text"><string>Executable File (.exe) - Próximamente</string></property></item>
             <item><property name="text"><string>PNG Image (.png) - Próximamente</string></property></item>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="lblFilePath">
             <property name="text"><string>Ruta del Archivo / Muestra:</string></property>
            </widget>
           </item>
           <item row="1" column="1">
            <layout class="QHBoxLayout" name="hLayoutPath">
             <item>
              <widget class="QLineEdit" name="txtFilePath">
               <property name="placeholderText"><string>Ejemplo: documento.pdf.exe</string></property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnBrowse">
               <property name="text"><string>Buscar...</string></property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="groupPreset">
          <property name="title">
           <string>Presets de Muestras Registradas (Caso de Estudio)</string>
          </property>
          <layout class="QVBoxLayout" name="vLayoutPreset">
           <item>
            <widget class="QPushButton" name="btnLoadSample">
             <property name="styleSheet"><string>background-color: #334155; color: #38bdf8;</string></property>
             <property name="text"><string>Cargar Muestra Sospechosa: "documento.pdf.exe"</string></property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btnRunAnalysis">
             <property name="styleSheet"><string>background-color: #059669; font-size: 14px;</string></property>
             <property name="text"><string>🚀 Ejecutar Extractor Binario en C &amp; Módulo Python</string></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <spacer name="spacerUpload">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>20</width>
            <height>40</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </widget>

      <!-- PESTAÑA 3: DASHBOARD FORENSE & MITRE ATT&CK -->
      <widget class="QWidget" name="tabDashboard">
       <attribute name="title">
        <string>🛡️ Análisis Forense &amp; MITRE ATT&amp;CK</string>
       </attribute>
       <layout class="QVBoxLayout" name="vLayoutDashboard">
        <item>
         <widget class="QGroupBox" name="groupMitre">
          <property name="styleSheet"><string>QGroupBox { border: 2px solid #ef4444; background-color: #18080a; }</string></property>
          <property name="title"><string>🚨 Alerta Forense &amp; Mapeo MITRE ATT&amp;CK</string></property>
          <layout class="QVBoxLayout" name="vLayoutMitre">
           <item>
            <widget class="QLabel" name="lblMitreTactica">
             <property name="styleSheet"><string>color: #f87171; font-weight: bold; font-size: 14px;</string></property>
             <property name="text"><string>Táctica: Defense Evasion (TA0005)</string></property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="lblMitreTecnica">
             <property name="styleSheet"><string>color: #fca5a5; font-weight: bold;</string></property>
             <property name="text"><string>Técnica: T1036.001 - Masquerading: Invalid Code Signature / Extension</string></property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="lblMitreDesc">
             <property name="styleSheet"><string>color: #e2e8f0;</string></property>
             <property name="text"><string>Descripción: El archivo oculta su formato ejecutable real bajo una extensión de documento no ejecutable.</string></property>
             <property name="wordWrap"><bool>true</bool></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="groupHeaders">
          <property name="title"><string>Análisis de Cabeceras (Módulo C / Python)</string></property>
          <layout class="QFormLayout" name="formLayoutHeaders">
           <item row="0" column="0"><widget class="QLabel" name="lblExtReal"><property name="text"><string>Extensión Real (Magic Bytes):</string></property></widget></item>
           <item row="0" column="1"><widget class="QLabel" name="valExtReal"><property name="styleSheet"><string>color: #ef4444; font-weight: bold;</string></property><property name="text"><string>.exe (MZ/PE Header Detected)</string></property></widget></item>
           <item row="1" column="0"><widget class="QLabel" name="lblExtDecl"><property name="text"><string>Extensión Declarada:</string></property></widget></item>
           <item row="1" column="1"><widget class="QLabel" name="valExtDecl"><property name="styleSheet"><string>color: #f59e0b;</string></property><property name="text"><string>.pdf</string></property></widget></item>
           <item row="2" column="0"><widget class="QLabel" name="lblAnomalia"><property name="text"><string>Anomalía Detectada:</string></property></widget></item>
           <item row="2" column="1"><widget class="QLabel" name="valAnomalia"><property name="styleSheet"><string>color: #ef4444; font-weight: bold;</string></property><property name="text"><string>Sí (DISCREPANCIA GRAVE DE FORMATO)</string></property></widget></item>
          </layout>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- PESTAÑA 4: VISOR HEXADECIMAL Y BINARIO -->
      <widget class="QWidget" name="tabHexViewer">
       <attribute name="title">
        <string>💻 Visor Hex / Binario</string>
       </attribute>
       <layout class="QVBoxLayout" name="vLayoutHex">
        <item>
         <widget class="QLabel" name="lblHexInfo">
          <property name="text"><string>Volcado Binario/Hexadecimal extraído por el ejecutable en C:</string></property>
         </widget>
        </item>
        <item>
         <widget class="QTableWidget" name="tblHexDump">
          <property name="columnCount"><number>3</number></property>
          <column><property name="text"><string>Offset</string></property></column>
          <column><property name="text"><string>Hexadecimal Bytes</string></property></column>
          <column><property name="text"><string>ASCII / Decoded</string></property></column>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="groupBinary">
          <property name="title"><string>Flujo Binario Bruto (Raw Bits)</string></property>
          <layout class="QVBoxLayout" name="vLayoutRawBits">
           <item>
            <widget class="QTextEdit" name="txtBinaryStream">
             <property name="readOnly"><bool>true</bool></property>
             <property name="font">
              <font><family>Consolas</family><pointsize>10</pointsize></font>
