  </property>
  <property name="windowTitle">
   <string>MDArch Forensics &amp; Threat Detection</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    QMainWindow {
      background-color: #171134;
      color: #ffffff;
      font-family: 'Segoe UI', system-ui, sans-serif;
    }
    QWidget {
      color: #cbd5e1;
      font-size: 13px;
    }

    /* Barra de navegación superior (solo dentro de Dashboard) */
    QFrame#topNavBar {
      background-color: #120d29;
      border-bottom: 1px solid #281d54;
      padding: 10px 24px;
    }

    /* Tabs de navegación estilo Avast */
    QListWidget#menuList {
      background: transparent;
      border: none;
      outline: 0;
    }
    QListWidget#menuList::item {
      color: #9d91cb;
      padding: 8px 22px;
      margin-right: 8px;
      border-radius: 20px;
      font-weight: 700;
      background-color: #211846;
    }
    QListWidget#menuList::item:selected {
      background-color: #00d68f;
      color: #0b1120;
    }
    QListWidget#menuList::item:hover:!selected {
      background-color: #2e2262;
      color: #ffffff;
    }

    /* Tarjetas y Contenedores */
    QFrame#cardHero {
      background-color: #241c4d;
      border: 1px solid #35286e;
      border-radius: 16px;
      padding: 24px;
    }
    QFrame#cardModule1, QFrame#cardModule2 {
      background-color: #211947;
      border: 1px solid #332669;
      border-radius: 14px;
    }
    QFrame#cardModule1:hover, QFrame#cardModule2:hover {
      border: 1px solid #4d3a9c;
    }

    /* Botón verde Avast */
    QPushButton#btnRunAnalysis {
      background-color: #00d68f;
      color: #0b1120;
      font-size: 15px;
      font-weight: 800;
      border-radius: 24px;
      padding: 14px 42px;
      border: none;
    }
    QPushButton#btnRunAnalysis:hover {
      background-color: #05f0a2;
    }
    QPushButton#btnRunAnalysis:pressed {
      background-color: #00ba7c;
    }

    /* Botones de acción */
    QPushButton#btnBrowse {
      background-color: #3b2f7a;
      color: #ffffff;
      font-weight: 600;
      border-radius: 16px;
      padding: 8px 22px;
      border: 1px solid #5544ad;
    }
    QPushButton#btnBrowse:hover {
      background-color: #4b3c9b;
    }

    QPushButton#btnLoadSample {
      background-color: transparent;
      color: #a797ec;
      border: 1px dashed #4e3e94;
      border-radius: 8px;
      padding: 9px 14px;
      font-weight: 600;
    }
    QPushButton#btnLoadSample:hover {
      background-color: #291e56;
      color: #ffffff;
      border-color: #7966df;
    }

    /* Entradas */
    QLineEdit, QComboBox, QTextEdit {
      background-color: #171134;
      border: 1px solid #3c2c78;
      border-radius: 8px;
      color: #ffffff;
      padding: 8px 12px;
    }
    QLineEdit:focus, QComboBox:focus, QTextEdit:focus {
      border: 1px solid #00d68f;
    }

    /* Botón Salir */
    QPushButton#btnLogout {
      background-color: transparent;
      color: #f87171;
      border: 1px solid #6b1d31;
      border-radius: 16px;
      padding: 6px 18px;
      font-weight: 600;
    }
    QPushButton#btnLogout:hover {
      background-color: #521626;
      color: #ffffff;
    }

    /* Tablas */
    QTableWidget {
      background-color: #120d29;
      gridline-color: #291e56;
      border: 1px solid #322569;
      border-radius: 10px;
      color: #00d68f;
      font-family: 'Consolas', monospace;
    }
    QHeaderView::section {
      background-color: #1e1643;
      color: #b5a9e3;
      padding: 8px;
      font-weight: bold;
      border: none;
      border-bottom: 1px solid #322569;
    }
   </string>
