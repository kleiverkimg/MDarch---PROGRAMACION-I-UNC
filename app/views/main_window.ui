  <property name="styleSheet">
   <string notr="true">
    QMainWindow {
      background-color: #0b0f19;
      color: #e2e8f0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    QWidget {
      color: #cbd5e1;
    }
    QTabWidget::pane {
      border: 1px solid #1e293b;
      background-color: #0f172a;
      border-radius: 8px;
    }
    QTabBar::tab {
      background: #1e293b;
      color: #94a3b8;
      padding: 10px 20px;
      margin-right: 4px;
      border-top-left-radius: 6px;
      border-top-right-radius: 6px;
      font-weight: bold;
    }
    QTabBar::tab:selected {
      background: #0f172a;
      color: #38bdf8;
      border-bottom: 3px solid #06b6d4;
    }
    QGroupBox {
      border: 1px solid #334155;
      border-radius: 8px;
      margin-top: 12px;
      font-weight: bold;
      color: #38bdf8;
    }
    QGroupBox::title {
      subcontrol-origin: margin;
      left: 10px;
      padding: 0 5px;
    }
    QLineEdit, QTextEdit, QComboBox {
      background-color: #1e293b;
      border: 1px solid #475569;
      border-radius: 6px;
      color: #f8fafc;
      padding: 6px;
    }
    QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
      border: 1px solid #06b6d4;
    }
    QPushButton {
      background-color: #0284c7;
      color: #ffffff;
      border-radius: 6px;
      font-weight: bold;
      padding: 8px 16px;
    }
    QPushButton:hover {
      background-color: #0369a1;
    }
    QPushButton#btnLogin {
      background-color: #0d9488;
    }
    QPushButton#btnLogin:hover {
      background-color: #0f766e;
    }
    QTableWidget {
      background-color: #020617;
      gridline-color: #1e293b;
      border: 1px solid #1e293b;
      color: #22c55e;
      font-family: 'Consolas', 'Courier New', monospace;
    }
    QHeaderView::section {
      background-color: #1e293b;
      color: #f8fafc;
      padding: 4px;
      font-weight: bold;
      border: 1px solid #334155;
    }
   </string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayoutMain">
    <property name="leftMargin"><number>15</number></property>
    <property name="topMargin"><number>15</number></property>
    <property name="rightMargin"><number>15</number></property>
    <property name="bottomMargin"><number>15</number></property>
    <item>
