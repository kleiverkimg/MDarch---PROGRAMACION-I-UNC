      <!-- PESTAÑA 1: LOGIN -->
      <widget class="QWidget" name="tabLogin">
       <attribute name="title">
        <string>🔑 Autenticación</string>
       </attribute>
       <layout class="QVBoxLayout" name="vLayoutLogin">
        <item>
